# App
PORT=3000
NODE_ENV=development

# Git
GIT_REPO_PATH=/absolute/path/to/target/repo

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM
LLM_PROVIDER=gemini            # gemini | anthropic

# Gemini (기본)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (선택)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
